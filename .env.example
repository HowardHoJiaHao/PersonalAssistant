# --- Model seam -------------------------------------------------------
# Any OpenAI-compatible endpoint works; only these three lines change.
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com

# NOTE: DeepSeek's model names move. `deepseek-chat` and `deepseek-reasoner`
# are retired; as of 2026-09-23 the live names are `deepseek-flash` (cheap,
# fine for extraction) and `deepseek-v4-pro` (stronger, use it if extraction
# quality disappoints). Re-check https://api-docs.deepseek.com/quick_start/pricing
# before assuming this still resolves — a wrong name fails fast with a 400.
LLM_MODEL=deepseek-flash

# Low temperature: extraction should be boring and repeatable, not creative.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# Other hosts, for reference — same adapter, no code change:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Together    LLM_BASE_URL=https://api.together.xyz/v1
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1

# --- Database seam ----------------------------------------------------
# Moving to Postgres is this line and nothing else.
# A relative sqlite path is anchored to the project directory, so it is the
# same database whichever directory you launch from.
DATABASE_URL=sqlite:///memory.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/relmem
SQL_ECHO=0

# --- Agent ------------------------------------------------------------
MAX_ITERATIONS=8
HISTORY_TURNS=10

# Becomes the Telegram user id when that interface lands. Threaded through
# every query already, so multi-user needs no schema change.
DEFAULT_OWNER_ID=local

# --- Voice seam -------------------------------------------------------
# Off by default: faster-whisper is optional and its model is a large
# download. Language is auto-detected on purpose — these notes mix
# English, Malay and Chinese, and pinning a language makes Whisper
# translate the others instead of transcribing them.
VOICE_ENABLED=0

# Model size, biggest that fits your machine:
#   small     ~0.5GB  fast, weakest on mixed-language speech
#   medium    ~1.5GB  the sweet spot on 4 cores / limited RAM
#   large-v3  ~3.0GB  best on rojak, needs RAM you may not have spare
WHISPER_MODEL=medium
WHISPER_BEAM_SIZE=5

# Primes Whisper for code-switching. Rewrite this in YOUR speaking style —
# real names, real mix of languages. It biases the decoder and reduces it
# flattening Malay and Chinese into English.
WHISPER_PROMPT=Lepak with Wai Keong at the mamak semalam, he cakap he wants to makan matcha ice cream. 明天 we go badminton at Bangsar lah.

# --- Telegram interface -----------------------------------------------
# Get a token from @BotFather. TELEGRAM_ALLOWED_USERS is your numeric
# Telegram user id (from @userinfobot); the bot refuses to start without
# it, because an empty allow-list means anyone who finds the bot could
# write to your memory.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USERS=
